# App
APP_NAME=berry-mrag-backend
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# Retrieval
TOP_K=3

# YOLO inference
YOLO_MODEL_PATH=D:/0code/berry-mrag-system/yolov8n.pt
YOLO_DEVICE=cuda:0
YOLO_CONF=0.25
YOLO_IOU=0.45
YOLO_BUSINESS_CONF=0.45

# Embedding (DashScope OpenAI-compatible)
DASHSCOPE_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
